# Copy to .env (gitignored) and fill in for local testing, or set these in your
# host's build-environment UI for production. Everything here is optional —
# the site builds fine with none of these set.
#
# These are ALL build-time variables for a static site: they are read during
# `astro build` and inlined into the output. Changing any of them requires a
# rebuild + redeploy — there is no runtime configuration.
#
# NOTE: analytics scripts are emitted ONLY in production builds (`astro build`)
# when the selected provider's vars are present. `pnpm dev` never emits them.

# ----------------------------------------------------------------------------
# Production URL (drives canonical, OG, sitemap, robots). See README.
# ----------------------------------------------------------------------------
# SITE_URL=https://your-domain.example

# ----------------------------------------------------------------------------
# Analytics — privacy-friendly only. Pick ONE provider.
# ----------------------------------------------------------------------------
# PUBLIC_ANALYTICS_PROVIDER=plausible   # plausible | umami | cloudflare

# Plausible (cookieless; pageviews + custom events)
# PUBLIC_PLAUSIBLE_DOMAIN=your-domain.example
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js   # optional override (self-hosted)

# Umami (cookieless; pageviews + custom events)
# PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
# PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Cloudflare Web Analytics (cookieless; pageviews only — no custom events)
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=your-cf-beacon-token

# ----------------------------------------------------------------------------
# Google Search Console verification (URL-prefix meta-tag method). Optional —
# prefer DNS verification if you can. Emitted as a <meta> tag when set.
# ----------------------------------------------------------------------------
# PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-token
