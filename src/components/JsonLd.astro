---
/**
 * Emits one or more schema.org JSON-LD blocks. Helps answer engines and
 * crawlers parse and attribute the content. `<` is escaped to prevent a
 * `</script>` breakout from any string field.
 */
interface Props {
  schema: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { schema } = Astro.props;
const blocks = Array.isArray(schema) ? schema : [schema];
---

{
  blocks.map((block) => (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(block).replace(/</g, '\\u003c')}
    />
  ))
}
