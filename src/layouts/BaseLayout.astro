---
/**
 * Base page shell: <head>, sticky header, footer, skip link.
 * All pages render through this. Keeps semantic landmarks in one place.
 */
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Logo from '../components/Logo.astro';
import { SITE, NAV } from '../config';

interface Props {
  title: string;
  description: string;
  fullTitle?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const props = Astro.props;
const year = 2026; // build-time constant; bump on rebuild if desired
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#3e1778" />
    <meta name="color-scheme" content="light dark" />
    <Seo {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <Logo height={26} class="brand__logo" />
          <span>{SITE.name}</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                {...('external' in item && item.external
                  ? { target: '_blank', rel: 'noopener' }
                  : {})}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <div class="site-footer__brand">
          <Logo height={22} />
          <p>
            {SITE.name} — open-source, local-first tooling for predictable
            iOS/macOS test execution. Built by {SITE.author}.
          </p>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <a href="/">Home</a>
          <a href="/failures/">Failure modes</a>
          <a href="/beta/">Try the alpha</a>
          <a href={SITE.repo} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.issues} target="_blank" rel="noopener">Open an issue</a>
        </nav>
        <p class="visually-hidden">© {year} {SITE.author}</p>
      </div>
    </footer>
  </body>
</html>
