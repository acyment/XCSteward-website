---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FailureCard from '../../components/FailureCard.astro';
import Callout from '../../components/Callout.astro';
import Cta from '../../components/Cta.astro';
import { CATEGORY_META, CATEGORY_ORDER } from '../../lib/site-content';
import type { Category } from '../../content.config';

const entries = await getCollection('failures', ({ data }) => !data.draft);

// Group entries by category, each group sorted by `order`.
const groups = CATEGORY_ORDER.map((cat: Category) => ({
  cat,
  meta: CATEGORY_META[cat],
  items: entries
    .filter((e) => e.data.category === cat)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((g) => g.items.length > 0);

const total = entries.length;

const title = 'XCSteward failure-mode library';
const description =
  'A hand-written library of local Xcode, xcodebuild, simctl, and iOS Simulator test-execution failures — grouped by failure class, with quick checks, manual mitigations, and where XCSteward may help.';
---

<BaseLayout title={title} description={description} fullTitle={`${title}`}>
  <section class="container prose" style="margin-top: 2.5rem;">
    <p class="breadcrumb"><a href="/">Home</a> / Failure modes</p>
    <h1>Failure-mode library</h1>
    <p class="lede">
      Symptom-first writeups of the operational failures that show up around
      local XCTest, <code>xcodebuild</code>, <code>simctl</code>, and the iOS
      Simulator. Each page is useful on its own — quick checks and manual
      mitigations first, and an honest note on where XCSteward may or may not
      help.
    </p>

    <Callout title="What this list is — and is not">
      <p>
        These are failures we have actually hit, grouped by failure class — not
        mass-generated content. They focus on <strong>operational fragility</strong>
        in test execution — readiness, destinations, lifecycle, cleanup,
        timeouts, and concurrency — <em>not</em> broken tests, code signing, or
        missing runtimes.
      </p>
    </Callout>

    <nav class="cat-jump" aria-label="Jump to category">
      {
        groups.map((g) => (
          <a href={`#${g.cat}`}>
            {g.meta.label} <span class="cat-jump__count">{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </section>

  {
    groups.map((g) => (
      <section class="container" id={g.cat} aria-labelledby={`${g.cat}-h`}>
        <div class="prose">
          <h2 id={`${g.cat}-h`}>{g.meta.label}</h2>
          <p class="lede">{g.meta.blurb}</p>
        </div>
        <ul
          class="grid grid--2"
          style="list-style: none; padding: 0; margin: 0;"
          role="list"
        >
          {g.items.map((entry) => (
            <li>
              <FailureCard
                href={`/failures/${entry.id}/`}
                title={entry.data.title}
                symptom={entry.data.symptom}
                failureClass={entry.data.failureClass}
                fit={entry.data.fit}
                fitNote={entry.data.fitNote}
              />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="container prose">
    <p class="failures-count">{total} failure modes and counting.</p>
    <Cta />
  </section>
</BaseLayout>
