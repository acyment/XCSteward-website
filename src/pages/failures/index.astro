---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FailureCard from '../../components/FailureCard.astro';
import Callout from '../../components/Callout.astro';
import Cta from '../../components/Cta.astro';
import { CATEGORY_META, CATEGORY_ORDER } from '../../lib/site-content';
import type { Category } from '../../content.config';

const entries = await getCollection('failures', ({ data }) => !data.draft);

// Group entries by category, each group sorted by `order`.
const groups = CATEGORY_ORDER.map((cat: Category) => ({
  cat,
  meta: CATEGORY_META[cat],
  items: entries
    .filter((e) => e.data.category === cat)
    .sort((a, b) => a.data.order - b.data.order),
})).filter((g) => g.items.length > 0);

const seenQueries = new Set<string>();
const searchRows = groups
  .flatMap((g) =>
    g.items.flatMap((entry) =>
      entry.data.queries.map((query) => ({
        query,
        title: entry.data.title,
        href: `/failures/${entry.id}/`,
      })),
    ),
  )
  .filter((row) => {
    const key = row.query.toLocaleLowerCase();
    if (seenQueries.has(key)) return false;
    seenQueries.add(key);
    return true;
  });

const total = entries.length;

const title = 'iOS Simulator hang and xcodebuild failure library';
const description =
  'A hand-written library for iOS Simulator hangs, xcodebuild timeouts, simctl/CoreSimulator stalls, destination errors, and agent-amplified local test failures.';

const origin = (Astro.site ?? new URL('https://xcsteward.com')).origin;
const pageUrl = `${origin}/failures/`;
const orderedEntries = groups.flatMap((g) => g.items);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: pageUrl,
    about: searchRows.map((row) => ({ '@type': 'Thing', name: row.query })),
    isPartOf: { '@type': 'WebSite', name: 'XCSteward', url: `${origin}/` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'XCSteward failure modes',
    itemListElement: orderedEntries.map((entry, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${origin}/failures/${entry.id}/`,
      name: entry.data.title,
      description: entry.data.symptom,
    })),
  },
];
---

<BaseLayout title={title} description={description} fullTitle={`${title}`} jsonLd={jsonLd}>
  <section class="container prose" style="margin-top: 2.5rem;">
    <p class="breadcrumb"><a href="/">Home</a> / Failure modes</p>
    <h1>Failure-mode library</h1>
    <p class="lede">
      Symptom-first writeups of the operational failures that show up around
      local XCTest, <code>xcodebuild</code>, <code>simctl</code>, and the iOS
      Simulator. Each page is useful on its own — quick checks and manual
      mitigations first, and an honest note on where XCSteward may or may not
      help.
    </p>

    <Callout title="What this list is — and is not">
      <p>
        These are failures we have actually hit, grouped by failure class — not
        mass-generated content. They focus on <strong>operational fragility</strong>
        in test execution — readiness, destinations, lifecycle, cleanup,
        timeouts, and concurrency — <em>not</em> broken tests, code signing, or
        missing runtimes.
      </p>
    </Callout>

    <nav class="cat-jump" aria-label="Jump to category">
      {
        groups.map((g) => (
          <a href={`#${g.cat}`}>
            {g.meta.label} <span class="cat-jump__count">{g.items.length}</span>
          </a>
        ))
      }
    </nav>
  </section>

  <section class="container" aria-labelledby="search-pain-heading">
    <div class="prose">
      <h2 id="search-pain-heading">Search by error message or stuck point</h2>
      <p class="lede">
        These are the kinds of phrases people paste after a local run wedges:
        simulator boot hangs, destination resolution stalls, <code>simctl</code>
        stops responding, or the test runner never attaches.
      </p>
    </div>
    <ul class="phrase-index" role="list">
      {
        searchRows.map((row) => (
          <li>
            <a href={row.href}>
              <code>{row.query}</code>
              <span>{row.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    groups.map((g) => (
      <section class="container" id={g.cat} aria-labelledby={`${g.cat}-h`}>
        <div class="prose">
          <h2 id={`${g.cat}-h`}>{g.meta.label}</h2>
          <p class="lede">{g.meta.blurb}</p>
        </div>
        <ul
          class="grid grid--2"
          style="list-style: none; padding: 0; margin: 0;"
          role="list"
        >
          {g.items.map((entry) => (
            <li>
              <FailureCard
                href={`/failures/${entry.id}/`}
                title={entry.data.title}
                symptom={entry.data.symptom}
                failureClass={entry.data.failureClass}
                fit={entry.data.fit}
                fitNote={entry.data.fitNote}
              />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section class="container prose">
    <p class="failures-count">{total} failure modes and counting.</p>
    <Cta />
  </section>
</BaseLayout>
