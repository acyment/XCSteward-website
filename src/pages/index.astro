---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import FailureCard from '../components/FailureCard.astro';
import FitList from '../components/FitList.astro';
import Callout from '../components/Callout.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../config';
import { GOOD_FIT, NOT_FIT, HELPS } from '../lib/site-content';

const allFailures = await getCollection('failures', ({ data }) => !data.draft);
// The landing shows a curated, featured subset; the full set lives at /failures/.
const failures = allFailures
  .filter((e) => e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const failureCount = allFailures.length;

const title = 'XCSteward';
const fullTitle =
  'XCSteward — predictable local XCTest & iOS Simulator test execution';
const description = SITE.description;

const origin = (Astro.site ?? new URL('https://xcsteward.com')).origin;
const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS',
  url: `${origin}/`,
  description,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: SITE.repo,
  sameAs: [SITE.repo],
  author: { '@type': 'Person', name: SITE.author },
};
---

<BaseLayout
  title={title}
  fullTitle={fullTitle}
  description={description}
  jsonLd={softwareLd}
>
  <!-- 1. HERO -->
  <Hero
    eyebrow="Open source · local-first · macOS"
    title="When local iOS Simulator test runs hang."
    subtitle="XCSteward is an OSS macOS tool for predictable XCTest, xcodebuild, simctl, and iOS Simulator execution. Single runs can hang at boot, destination resolution, or readiness; coding agents, scripts, and CI-like workflows sharing one Mac amplify that fragility."
  >
    <div class="btn-row">
      <Button href={SITE.repo} variant="primary" external event="github_repo_click">
        View on GitHub
      </Button>
      <Button href="/failures/" variant="secondary">
        Browse failure modes
      </Button>
    </div>
  </Hero>

  <!-- 2. WHY THIS EXISTS -->
  <section class="container prose" aria-labelledby="why-heading">
    <h2 id="why-heading">Why this exists</h2>
    <p>
      The pain did not start with CI. It got much worse the day coding agents
      started running iOS tests for me — across <strong>more than one app at the
      same time</strong>, on the same Mac.
    </p>
    <p>
      A single <code>xcodebuild</code> or Simulator run is already fragile on its
      own: runs hang before tests start, <code>simctl</code> stops responding,
      CoreSimulator wedges. Once several agents, scripts, CI-like jobs, and a
      human can all touch Xcode tooling on one machine, those same failures get
      frequent and stop being reproducible.
    </p>
    <Callout title="Concurrency amplifies — it is not the only cause">
      <p>
        This matters for positioning: XCSteward is not only a concurrency tool.
        The baseline fragility shows up even in a single run. Sharing one Mac
        between agents and scripts mostly makes existing problems more common and
        harder to debug.
      </p>
    </Callout>
    <p class="origin-link">
      <a href="/why/">Read the full origin story →</a>
    </p>
  </section>

  <!-- 3. HOW THIS DIFFERS FROM MCPs — moved up and made visually prominent
       so a cold visitor catches the positioning before the feature rundown. -->
  <section class="container" aria-labelledby="vs-mcp-heading">
    <aside class="mcp-callout">
      <p class="mcp-callout__eyebrow">XCSteward is not another Xcode / XCTest MCP</p>
      <h2 id="vs-mcp-heading" class="mcp-callout__title">
        MCPs help an agent <em>ask for</em> a test run. XCSteward makes that
        test run actually happen through a controlled local lane.
      </h2>
      <p>
        MCPs are useful bridges, and XCSteward is complementary to them — not a
        replacement or a criticism. An MCP lets a coding agent call Xcode,
        Simulator, or XCTest-related tools. XCSteward sits <em>underneath</em>
        those invocations and coordinates execution against fragile shared local
        state: CoreSimulator, simulator boot/shutdown, readiness, DerivedData,
        result bundles, logs, timeouts, cleanup, and process ownership.
      </p>
      <p class="mcp-callout__kicker">
        Keep your MCP, shell scripts, and hooks. XCSteward makes the run they
        trigger happen through one controlled local lane, instead of letting
        every agent, script, job, and human call <code>xcodebuild</code> /
        <code>simctl</code> directly.
      </p>
    </aside>
  </section>

  <!-- 4 & 5. GOOD FIT / NOT A FIT -->
  <section class="container" aria-labelledby="fit-heading">
    <div class="prose">
      <h2 id="fit-heading">Is this for you?</h2>
      <p class="lede">
        XCSteward is narrow on purpose. It targets operational fragility around
        local test execution — not your test code.
      </p>
    </div>
    <div class="fit-columns">
      <FitList tone="good" title="A good fit when" items={GOOD_FIT} />
      <FitList tone="bad" title="Not a fit for" items={NOT_FIT} />
    </div>
  </section>

  <!-- 5. HOW IT HELPS -->
  <section class="container prose" aria-labelledby="helps-heading">
    <h2 id="helps-heading">How XCSteward helps</h2>
    <p>
      It does not rewrite your tests or replace <code>xcodebuild</code>. It
      governs <em>how</em> runs are executed, isolated, and cleaned up so the
      simulator subsystem stays in a state you can reason about.
    </p>
    <ul class="feature-list">
      {
        HELPS.map((f) => (
          <li>
            <strong>{f.title}.</strong> {f.body}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 7. FAILURE-MODE LIBRARY -->
  <section class="container" aria-labelledby="library-heading">
    <div class="prose">
      <h2 id="library-heading">Failure-mode library</h2>
      <p>
        Symptom-first writeups of the failures XCSteward is built around. Each
        page has quick checks, manual mitigations, and an honest note on fit —
        useful even if you never install anything. A few to start with, from a
        library of {failureCount}:
      </p>
    </div>
    <ul
      class="grid grid--3"
      style="list-style: none; padding: 0; margin: 1.25rem 0 0;"
      role="list"
    >
      {
        failures.map((entry) => (
          <li>
            <FailureCard
              href={`/failures/${entry.id}/`}
              title={entry.data.title}
              symptom={entry.data.symptom}
              failureClass={entry.data.failureClass}
              fit={entry.data.fit}
              fitNote={entry.data.fitNote}
            />
          </li>
        ))
      }
    </ul>
    <p style="margin-top: 1.25rem;">
      <a href="/failures/">See all {failureCount} failure modes →</a>
    </p>
  </section>

  <!-- 8. ALPHA / BETA ASK -->
  <section id="beta" class="container prose" aria-labelledby="alpha-heading">
    <h2 id="alpha-heading">Try the alpha</h2>
    <p>
      Have a real failure mode around <code>xcodebuild</code>, <code>simctl</code>,
      Simulator readiness, cleanup, local CI-like workflows, or coding agents
      running iOS tests? Try the OSS alpha, or open an issue with your setup.
      It is local-first — no signup, no waitlist. The early feedback that helps
      most is specific: real logs, real setups, real failure modes, and the
      cases where XCSteward <em>does not</em> help.
    </p>

    <p>Install with Homebrew:</p>
    <pre><code><span class="token-comment"># requires macOS with a recent local Xcode</span>
brew tap acyment/tap
brew install xcsteward</code></pre>

    <p class="dogfood-note">
      Dogfooded on my own real iOS projects — each run is tracked in the public
      <a href="https://github.com/acyment/XCSteward/blob/main/docs/dogfood-ledger.md"
        >dogfood ledger</a
      >. It is honest about where it stands: early, alpha-stage OSS, narrow on
      purpose.
    </p>

    <Cta
      heading="Bring a real failure mode"
      intro="Worth your time only if you actually hit these failures — please bring reproducible pain, not curiosity."
    />
    <p style="margin-top: 1.25rem;">
      <a href="/try/" data-analytics-event="beta_cta_click"
        >Read the full alpha &amp; reporting guide →</a
      >
    </p>
    <p class="byline">
      Built by <a href="https://github.com/acyment" rel="author">Alan Cyment</a>,
      a Buenos Aires&ndash;based developer and organizational consultant,
      while dogfooding coding agents on iOS projects.
    </p>
  </section>
</BaseLayout>
